# Auth.js / Google OAuth
# Generate a signing secret with: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console OAuth 2.0 client. For local development, authorize:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma- or whitespace-separated Google accounts. Empty fails closed.
ALLOWED_USERS=

# OpenAI-compatible API (default: DeepSeek)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# Reddit requires a descriptive User-Agent
REDDIT_USER_AGENT=ai-dashboard/0.1 (news aggregator)
